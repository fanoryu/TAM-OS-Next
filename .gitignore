# TAM Intelligence OS — version control ignores
# The app itself needs no dependencies; Node is used only for build/verify tooling.

# ---------------------------------------------------------------------------
# Node tooling
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
*.log

# ---------------------------------------------------------------------------
# Secrets & credentials — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.credentials
*credentials*
*secret*
*token*.txt
.npmrc

# ---------------------------------------------------------------------------
# SAMPLE-DATA POLICY — no real company data in the repository
# ---------------------------------------------------------------------------
# Real payroll/employee/contract workbooks, Complete Backup JSON exports, and any
# uploaded evidence/attachments must NOT be committed. Only clearly-fabricated sample
# data is allowed, and it must live under samples/ with an obvious placeholder name.
#
# Ignore real-data artifacts anywhere in the tree:
*.xlsx
*.xls
*.xlsm
*.csv
*-backup*.json
*complete-backup*.json
*-pre-reset-backup*.json
tam-*-settings.json
uploads/
evidence/
private/
backups-local/
# ...but allow explicitly-fabricated samples committed on purpose:
!samples/**

# ---------------------------------------------------------------------------
# PUBLIC-CORE / PRIVATE-COMPANY-LAYER SEPARATION
# Production company data and configuration live OUTSIDE this public-core repo
# (see docs/DEPLOYMENT.md). Never commit any of the following here:
# ---------------------------------------------------------------------------
company-data/
production-data/
exports/
backups/
deployment/production*
*.prod.json
*.production.*
config.local.*
settings.local.*

# ---------------------------------------------------------------------------
# Build scratch (NOT the release HTML — see the intentionally-tracked block below)
# ---------------------------------------------------------------------------
dist/*.tmp
# Distribution-1 package outputs are regenerated by `node tools/build-package.js` and
# verified against the committed dist/package-manifest.json; they are never committed.
dist/package/
dist/*-package.zip

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.vscode/settings.json
.vscode/*.log
.idea/
*.swp
.claude/settings.local.json
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Intentionally tracked (do NOT ignore)
# ---------------------------------------------------------------------------
# Historical single-file releases (dist/*.html) and the Distribution-1 package manifest ARE
# version-controlled. dist/*.tmp, dist/package/ and the ZIP above are scratch/build output only.
!dist/
!dist/*.html
!dist/package-manifest.json
